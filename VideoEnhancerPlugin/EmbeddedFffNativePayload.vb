Friend Module EmbeddedFffNativePayload
    Private ReadOnly _sync As New Object()
    Private _folder As String
    Friend Function EnsureExtracted() As String
        SyncLock _sync
            If Not String.IsNullOrEmpty(_folder) AndAlso File.Exists(Path.Combine(_folder, "FFF.Native.dll")) Then Return Path.Combine(_folder, "FFF.Native.dll")
            _folder = Path.Combine(Path.GetTempPath(), "videoenhancer.3fui", "fff-native-11")
            Directory.CreateDirectory(_folder)
            For Each item In Payloads()
                Dim target = Path.Combine(_folder, item.Key)
                If Not File.Exists(target) OrElse New FileInfo(target).Length = 0 Then File.WriteAllBytes(target, Inflate(item.Value))
            Next
            Return Path.Combine(_folder, "FFF.Native.dll")
        End SyncLock
    End Function
    Private Function Inflate(text As String) As Byte()
        Dim compressed = Convert.FromBase64String(text)
        Using source As New MemoryStream(compressed), zip As New GZipStream(source, CompressionMode.Decompress), result As New MemoryStream()
            zip.CopyTo(result)
            Return result.ToArray()
        End Using
    End Function
