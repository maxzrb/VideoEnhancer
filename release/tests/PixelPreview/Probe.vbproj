<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace />
    <OptionStrict>On</OptionStrict>
    <LakeUIVersion Condition="'$(LakeUIVersion)' == ''">5.201.0</LakeUIVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LakeUI" Version="$(LakeUIVersion)" />
    <Compile Include="../../../VideoEnhancerPlugin/PixelPreviewImage.vb" Link="PixelPreviewImage.vb" />
  </ItemGroup>
</Project>
