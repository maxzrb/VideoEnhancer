<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Project">
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>videoenhancer</AssemblyName>
    <RootNamespace>VideoEnhancer</RootNamespace>
    <Version>1.3.7</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Label="Publish">
    <!-- 单文件自包含运行程序；便携安装器只负责首次安装。 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- 压缩并裁剪未使用的 .NET 运行库；保留完全自包含，无需用户安装 .NET。 -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Label="Paths">
    <VideoEnhancerRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..'))\</VideoEnhancerRepositoryRoot>
    <ArtifactsDirectory>$(VideoEnhancerRepositoryRoot)Artifacts\</ArtifactsDirectory>
    <PluginProjectPath>$(VideoEnhancerRepositoryRoot)VideoEnhancerPlugin\VideoEnhancerPlugin.vbproj</PluginProjectPath>
    <!-- 安装布局的固定文件名；运行时代码也以这两个名称定位便携组件。 -->
    <PluginArtifactFileName>videoenhancer.3fui.dll</PluginArtifactFileName>
    <InstalledExecutableFileName>videoenhancer.exe</InstalledExecutableFileName>
    <PluginArtifactPath>$(VideoEnhancerRepositoryRoot)VideoEnhancerPlugin\obj\plugin-artifact\$(PluginArtifactFileName)</PluginArtifactPath>
    <ManualInstallReadmePath>$(MSBuildProjectDirectory)\manual-install-readme.txt</ManualInstallReadmePath>
    <InstallerArtifactPath>$(ArtifactsDirectory)VideoEnhancerInstaller.exe</InstallerArtifactPath>
    <PortablePayloadPath>$(ArtifactsDirectory).installer\VideoEnhancerPortablePayload.exe</PortablePayloadPath>
    <RuntimeArtifactPath>$(ArtifactsDirectory)videoenhancer.exe</RuntimeArtifactPath>
    <ManualPackagePath>$(ArtifactsDirectory)VideoEnhancer.zip</ManualPackagePath>
    <ThirdPartyNoticePath>$(MSBuildProjectDirectory)\THIRD-PARTY-NOTICES.txt</ThirdPartyNoticePath>
    <ProjectLicensePath>$(VideoEnhancerRepositoryRoot)LICENSE</ProjectLicensePath>
    <Aria2NextLicensePath>$(MSBuildProjectDirectory)\third-party\aria2-next\COPYING</Aria2NextLicensePath>
    <Aria2NextAuthorsPath>$(MSBuildProjectDirectory)\third-party\aria2-next\AUTHORS</Aria2NextAuthorsPath>
    <Aria2NextSourcePath>$(MSBuildProjectDirectory)\third-party\aria2-next\SOURCE.txt</Aria2NextSourcePath>
    <Aria2NextDependencyLicensesPath>$(MSBuildProjectDirectory)\third-party\aria2-next\DEPENDENCY-LICENSES.txt</Aria2NextDependencyLicensesPath>
    <SharpCompressLicensePath>$(MSBuildProjectDirectory)\third-party\SharpCompress\LICENSE.txt</SharpCompressLicensePath>
  </PropertyGroup>

  <PropertyGroup Label="Third-party components">
    <!-- aria2-next 作为独立 GPL 组件安装，不再嵌入 videoenhancer.exe。 -->
    <Aria2NextVersion>2.8.3</Aria2NextVersion>
    <Aria2NextDownloadUrl>https://github.com/AnInsomniacy/aria2-next/releases/download/v$(Aria2NextVersion)/aria2-next-$(Aria2NextVersion)-windows-x86_64.exe</Aria2NextDownloadUrl>
    <Aria2NextSha256>08AFAF2A44811D38E7CE538DA719AB06D6925BCAAD1231EE7B92C497F58E5AAC</Aria2NextSha256>
    <Aria2NextSourceSha256>420E31256B5E29DE6AB9B295423ED29431494527B4FDC9AFB3946DFF4A73EAF7</Aria2NextSourceSha256>
    <Aria2NextCacheDirectory>$(MSBuildProjectDirectory)\obj\third-party\aria2-next\$(Aria2NextVersion)</Aria2NextCacheDirectory>
    <Aria2NextExecutablePath>$(Aria2NextCacheDirectory)\aria2-next.exe</Aria2NextExecutablePath>
    <Aria2NextSourceArchivePath>$(Aria2NextCacheDirectory)\aria2-next-$(Aria2NextVersion)-source.tar.gz</Aria2NextSourceArchivePath>
  </PropertyGroup>

  <ItemGroup Label="Project references">
    <ProjectReference Include="$(PluginProjectPath)"
                      Condition="'$(BuildingSolutionFile)' == 'true'"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Label="Package references">
    <!-- 代替原先随程序分发的 7za.exe；许可证文本随安装包一同发布。 -->
    <PackageReference Include="SharpCompress" Version="0.50.3" />
  </ItemGroup>

  <ItemGroup Label="Embedded resources">
    <EmbeddedResource Include="$(PluginArtifactPath)"
                      LogicalName="VideoEnhancer.Embedded.videoenhancer.3fui.dll"
                      Condition="'$(BuildingSolutionFile)' == 'true'" />
    <EmbeddedResource Include="$(ThirdPartyNoticePath)"
                      LogicalName="VideoEnhancer.Embedded.THIRD-PARTY-NOTICES.txt" />
    <EmbeddedResource Include="$(ProjectLicensePath)"
                      LogicalName="VideoEnhancer.Embedded.LICENSE.txt" />
    <EmbeddedResource Include="$(SharpCompressLicensePath)"
                      LogicalName="VideoEnhancer.Embedded.SharpCompress.LICENSE.txt" />
    <EmbeddedResource Include="embedded-tools\rve-ordered-backend.py"
                      LogicalName="VideoEnhancer.Embedded.rve-ordered-backend.py" />
    <EmbeddedResource Include="embedded-tools\inspect_interpolation_models.py"
                      LogicalName="VideoEnhancer.Embedded.inspect_interpolation_models.py" />
    <EmbeddedResource Include="embedded-tools\inspect_upscale_models.py"
                      LogicalName="VideoEnhancer.Embedded.inspect_upscale_models.py" />
    <EmbeddedResource Include="embedded-tools\prepare_rife_tensorrt.py"
                      LogicalName="VideoEnhancer.Embedded.prepare_rife_tensorrt.py" />
    <EmbeddedResource Include="embedded-tools\convert_tensorrt.py"
                      LogicalName="VideoEnhancer.Embedded.convert_tensorrt.py" />
    <EmbeddedResource Include="embedded-tools\rve-image-backend.py"
                      LogicalName="VideoEnhancer.Embedded.rve-image-backend.py" />
    <EmbeddedResource Include="embedded-tools\rve-segmented-backend.py"
                      LogicalName="VideoEnhancer.Embedded.rve-segmented-backend.py" />
    <EmbeddedResource Include="model-capabilities.json"
                      LogicalName="VideoEnhancer.Embedded.model-capabilities.json" />
  </ItemGroup>

  <Target Name="ValidateThirdPartyMetadata"
          BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(ProjectLicensePath)')"
           Text="缺少 VideoEnhancer 项目许可证：$(ProjectLicensePath)" />
    <Error Condition="!Exists('$(ThirdPartyNoticePath)')"
           Text="缺少第三方组件声明：$(ThirdPartyNoticePath)" />
    <Error Condition="!Exists('$(Aria2NextLicensePath)')"
           Text="缺少 aria2-next GPL 许可证：$(Aria2NextLicensePath)" />
    <Error Condition="!Exists('$(Aria2NextAuthorsPath)')"
           Text="缺少 aria2-next 作者声明：$(Aria2NextAuthorsPath)" />
    <Error Condition="!Exists('$(Aria2NextSourcePath)')"
           Text="缺少 aria2-next 对应源码说明：$(Aria2NextSourcePath)" />
    <Error Condition="!Exists('$(Aria2NextDependencyLicensesPath)')"
           Text="缺少 aria2-next 依赖许可证：$(Aria2NextDependencyLicensesPath)" />
    <Error Condition="!Exists('$(SharpCompressLicensePath)')"
           Text="缺少 SharpCompress 许可证：$(SharpCompressLicensePath)" />
  </Target>

  <Target Name="AcquireAria2Next"
          Condition="'$(BuildingSolutionFile)' == 'true'">
    <MakeDir Directories="$(Aria2NextCacheDirectory)" />
    <DownloadFile SourceUrl="$(Aria2NextDownloadUrl)"
                  DestinationFolder="$(Aria2NextCacheDirectory)"
                  DestinationFileName="aria2-next.exe"
                  SkipUnchangedFiles="true"
                  Retries="3"
                  RetryDelayMilliseconds="1000" />
    <GetFileHash Files="$(Aria2NextExecutablePath)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_Aria2NextWithHash" />
    </GetFileHash>
    <Error Condition="'%(_Aria2NextWithHash.FileHash)' != '$(Aria2NextSha256)'"
           Text="aria2-next v$(Aria2NextVersion) 校验失败：期望 $(Aria2NextSha256)，实际 %(_Aria2NextWithHash.FileHash)。" />
    <DownloadFile SourceUrl="https://github.com/AnInsomniacy/aria2-next/archive/refs/tags/v$(Aria2NextVersion).tar.gz"
                  DestinationFolder="$(Aria2NextCacheDirectory)"
                  DestinationFileName="aria2-next-$(Aria2NextVersion)-source.tar.gz"
                  SkipUnchangedFiles="true" Retries="3" />
    <GetFileHash Files="$(Aria2NextSourceArchivePath)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_Aria2NextSourceWithHash" />
    </GetFileHash>
    <Error Condition="'%(_Aria2NextSourceWithHash.FileHash)' != '$(Aria2NextSourceSha256)'"
           Text="aria2-next 对应源码校验失败：%(_Aria2NextSourceWithHash.FileHash)" />
  </Target>

  <Target Name="ValidateEmbeddedPlugin"
          BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(BuildingSolutionFile)' == 'true'">
    <Error Condition="!Exists('$(PluginProjectPath)')"
           Text="插件项目不存在：$(PluginProjectPath)" />
    <XmlPeek XmlInputPath="$(PluginProjectPath)"
             Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" ItemName="_PluginProjectVersion" />
    </XmlPeek>
    <Error Condition="'@(_PluginProjectVersion)' == ''"
           Text="插件项目未声明 Version：$(PluginProjectPath)" />
    <Error Condition="'@(_PluginProjectVersion)' != '$(Version)'"
           Text="插件版本 @(_PluginProjectVersion) 与 CLI 版本 $(Version) 不一致；请同步修改两个项目文件的 Version。" />
    <Error Condition="!Exists('$(PluginArtifactPath)')"
           Text="插件产物不存在：$(PluginArtifactPath)。项目引用本应先构建 VideoEnhancerPlugin；请检查 HostBin 配置。" />
  </Target>

  <Target Name="CreateSolutionArtifacts"
          AfterTargets="Publish"
          Condition="'$(BuildingSolutionFile)' == 'true'"
          DependsOnTargets="AcquireAria2Next">
    <PropertyGroup>
      <PublishedExecutable>$(PublishDir)$(AssemblyName).exe</PublishedExecutable>
      <ManualPackageStage>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(IntermediateOutputPath)manual-install'))</ManualPackageStage>
      <InstallerPayloadStage>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(IntermediateOutputPath)installer-payload'))</InstallerPayloadStage>
    </PropertyGroup>
    <Error Condition="!Exists('$(PublishedExecutable)')"
           Text="发布产物不存在：$(PublishedExecutable)" />
    <Error Condition="!Exists('$(PluginArtifactPath)')"
           Text="手动安装包缺少插件 DLL：$(PluginArtifactPath)" />
    <Error Condition="!Exists('$(ManualInstallReadmePath)')"
           Text="手动安装说明不存在：$(ManualInstallReadmePath)" />
    <MakeDir Directories="$(ArtifactsDirectory)" />
    <Copy SourceFiles="$(PublishedExecutable)"
          DestinationFiles="$(RuntimeArtifactPath)" />
    <Copy SourceFiles="$(Aria2NextSourceArchivePath)" DestinationFolder="$(ArtifactsDirectory)" />
    <RemoveDir Directories="$(ManualPackageStage)" />
    <RemoveDir Directories="$(InstallerPayloadStage)" />
    <MakeDir Directories="$(ManualPackageStage)\plugin\videoenhancer\bin\aria2-next;$(ManualPackageStage)\plugin\videoenhancer\licenses\aria2-next;$(ManualPackageStage)\plugin\videoenhancer\licenses\SharpCompress" />
    <Copy SourceFiles="$(PluginArtifactPath)"
          DestinationFiles="$(ManualPackageStage)\plugin\$(PluginArtifactFileName)" />
    <Copy SourceFiles="$(PublishedExecutable)"
          DestinationFiles="$(ManualPackageStage)\plugin\videoenhancer\$(InstalledExecutableFileName)" />
    <Copy SourceFiles="$(Aria2NextExecutablePath)"
          DestinationFiles="$(ManualPackageStage)\plugin\videoenhancer\bin\aria2-next\aria2-next.exe" />
    <Copy SourceFiles="$(ThirdPartyNoticePath)"
          DestinationFiles="$(ManualPackageStage)\plugin\videoenhancer\THIRD-PARTY-NOTICES.txt" />
    <Copy SourceFiles="$(ProjectLicensePath)"
          DestinationFiles="$(ManualPackageStage)\plugin\videoenhancer\LICENSE.txt" />
    <Copy SourceFiles="$(Aria2NextLicensePath)"
          DestinationFiles="$(ManualPackageStage)\plugin\videoenhancer\licenses\aria2-next\COPYING" />
    <Copy SourceFiles="$(Aria2NextAuthorsPath)"
          DestinationFiles="$(ManualPackageStage)\plugin\videoenhancer\licenses\aria2-next\AUTHORS" />
    <Copy SourceFiles="$(Aria2NextSourcePath)"
          DestinationFiles="$(ManualPackageStage)\plugin\videoenhancer\licenses\aria2-next\SOURCE.txt" />
    <Copy SourceFiles="$(Aria2NextDependencyLicensesPath)"
          DestinationFiles="$(ManualPackageStage)\plugin\videoenhancer\licenses\aria2-next\DEPENDENCY-LICENSES.txt" />
    <Copy SourceFiles="$(SharpCompressLicensePath)"
          DestinationFiles="$(ManualPackageStage)\plugin\videoenhancer\licenses\SharpCompress\LICENSE.txt" />

    <Copy SourceFiles="$(ManualInstallReadmePath)"
          DestinationFiles="$(ManualPackageStage)\手动安装说明.txt" />
    <ZipDirectory SourceDirectory="$(ManualPackageStage)"
                  DestinationFile="$(ManualPackagePath)"
                  Overwrite="true" />
    <MakeDir Directories="$(InstallerPayloadStage)\plugin\videoenhancer\bin\aria2-next;$(InstallerPayloadStage)\plugin\videoenhancer\licenses\aria2-next;$(InstallerPayloadStage)\plugin\videoenhancer\licenses\SharpCompress" />
    <Copy SourceFiles="$(Aria2NextExecutablePath)"
          DestinationFiles="$(InstallerPayloadStage)\plugin\videoenhancer\bin\aria2-next\aria2-next.exe" />
    <Copy SourceFiles="$(ThirdPartyNoticePath)"
          DestinationFiles="$(InstallerPayloadStage)\plugin\videoenhancer\THIRD-PARTY-NOTICES.txt" />
    <Copy SourceFiles="$(ProjectLicensePath)"
          DestinationFiles="$(InstallerPayloadStage)\plugin\videoenhancer\LICENSE.txt" />
    <Copy SourceFiles="$(Aria2NextLicensePath)"
          DestinationFiles="$(InstallerPayloadStage)\plugin\videoenhancer\licenses\aria2-next\COPYING" />
    <Copy SourceFiles="$(Aria2NextAuthorsPath)"
          DestinationFiles="$(InstallerPayloadStage)\plugin\videoenhancer\licenses\aria2-next\AUTHORS" />
    <Copy SourceFiles="$(Aria2NextSourcePath)"
          DestinationFiles="$(InstallerPayloadStage)\plugin\videoenhancer\licenses\aria2-next\SOURCE.txt" />
    <Copy SourceFiles="$(Aria2NextDependencyLicensesPath)"
          DestinationFiles="$(InstallerPayloadStage)\plugin\videoenhancer\licenses\aria2-next\DEPENDENCY-LICENSES.txt" />
    <Copy SourceFiles="$(SharpCompressLicensePath)"
          DestinationFiles="$(InstallerPayloadStage)\plugin\videoenhancer\licenses\SharpCompress\LICENSE.txt" />
    <MakeDir Directories="$(ArtifactsDirectory).installer" />
    <Delete Files="$(InstallerArtifactPath);$(PortablePayloadPath)" />
    <Exec Command="&quot;$(PublishedExecutable)&quot; --create-installer-bundle &quot;$(PublishedExecutable)&quot; &quot;$(PortablePayloadPath)&quot; &quot;$(InstallerPayloadStage)&quot;" />
    <Copy SourceFiles="$(PortablePayloadPath)" DestinationFiles="$(InstallerArtifactPath)" />
    <Error Condition="!Exists('$(InstallerArtifactPath)')"
           Text="便携安装器未生成预期文件：$(InstallerArtifactPath)" />
    <Message Importance="high" Text="便携插件安装程序：$(InstallerArtifactPath)" />
    <RemoveDir Directories="$(ManualPackageStage)" />
    <RemoveDir Directories="$(InstallerPayloadStage)" />
    <Message Importance="high" Text="手动安装包：$(ManualPackagePath)" />
  </Target>

  <Target Name="CleanSolutionArtifacts"
          AfterTargets="Clean"
          Condition="'$(BuildingSolutionFile)' == 'true'">
    <Delete Files="$(InstallerArtifactPath);$(PortablePayloadPath);$(ManualPackagePath);$(RuntimeArtifactPath)" />
  </Target>

</Project>
