<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Project">
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>videoenhancer</AssemblyName>
    <RootNamespace />
    <Version>1.3.9</Version>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <PropertyGroup Label="Compiler">
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <ImplicitUsings>disable</ImplicitUsings>
    <DisableImplicitNamespaceImports>true</DisableImplicitNamespaceImports>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Label="Paths">
    <PluginArtifactFileName>videoenhancer.3fui.dll</PluginArtifactFileName>
    <PluginArtifactDirectory>$(MSBuildProjectDirectory)\obj\plugin-artifact\</PluginArtifactDirectory>
    <PluginArtifactPath>$(PluginArtifactDirectory)$(PluginArtifactFileName)</PluginArtifactPath>
    <PluginInstallDir Condition="'$(PluginInstallDir)' == ''">$(VIDEOENHANCER_PLUGIN_DIR)</PluginInstallDir>
    <PluginInstallPath Condition="'$(PluginInstallDir)' != ''">$([System.IO.Path]::GetFullPath('$(PluginInstallDir)', $([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..'))))</PluginInstallPath>
  </PropertyGroup>

  <ItemGroup Label="Compile dependencies">
    <!-- 固定编译基线；运行时由宿主提供 LakeUI，不随插件复制另一份渲染框架。 -->
    <PackageReference Include="LakeUI" Version="5.110.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <Target Name="ValidateLakeUiCompileAssembly"
          AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_LakeUiCompileAssembly Include="@(ReferencePath)"
                              Condition="'%(ReferencePath.Filename)' == 'LakeUI'" />
    </ItemGroup>
    <Error Condition="'@(_LakeUiCompileAssembly)' == ''"
           Text="未解析到 LakeUI 编译程序集，请先还原插件项目的 NuGet 依赖。" />
    <GetAssemblyIdentity AssemblyFiles="@(_LakeUiCompileAssembly)">
      <Output TaskParameter="Assemblies" ItemName="_LakeUIIdentity" />
    </GetAssemblyIdentity>
    <Error Condition="'@(_LakeUIIdentity)' != '' And ($([MSBuild]::VersionLessThan('%(_LakeUIIdentity.Version)', '5.110.0.0')) Or $([MSBuild]::VersionGreaterThanOrEquals('%(_LakeUIIdentity.Version)', '6.0.0.0')))"
           Text="编译需要 LakeUI 5.110 或更新的 5.x 版本；当前为 %(_LakeUIIdentity.Version)：@(_LakeUiCompileAssembly)" />
    <Message Importance="high"
             Text="LakeUI 编译引用: %(_LakeUIIdentity.Version)；@(_LakeUiCompileAssembly)；运行时由宿主提供" />
  </Target>

  <Target Name="StagePluginArtifact" AfterTargets="Build">
    <MakeDir Directories="$(PluginArtifactDirectory)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFiles="$(PluginArtifactPath)"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="插件暂存产物：$(PluginArtifactPath)" />

    <MakeDir Directories="$(PluginInstallPath)"
             Condition="'$(PluginInstallDir)' != ''" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFiles="$(PluginInstallPath)\$(PluginArtifactFileName)"
          SkipUnchangedFiles="true"
          Condition="'$(PluginInstallDir)' != ''" />
    <Message Importance="high"
             Text="插件已安装到：$(PluginInstallPath)\$(PluginArtifactFileName)"
             Condition="'$(PluginInstallDir)' != ''" />
  </Target>

  <Target Name="CleanPluginArtifact" AfterTargets="Clean">
    <RemoveDir Directories="$(PluginArtifactDirectory)"
               Condition="Exists('$(PluginArtifactDirectory)')" />
  </Target>

</Project>
